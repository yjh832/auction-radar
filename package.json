{
  "name": "auction-radar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "vite preview --host 0.0.0.0",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc -b --pretty false",
    "refresh-preview": "node scripts/build-strategy.mjs",
    "refresh-review": "node scripts/build-strategy.mjs && PYTHONPATH=../work/baostock-packages python3 scripts/fetch-intraday.py",
    "intraday": "PYTHONPATH=../work/baostock-packages python3 scripts/fetch-intraday.py",
    "publish": "node scripts/publish.mjs",
    "sync": "node scripts/publish.mjs --watch",
    "android:sync": "npm run build && npx cap sync android",
    "icons": "node scripts/generate-icons.mjs",
    "review:daily": "node scripts/scheduled-review.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
